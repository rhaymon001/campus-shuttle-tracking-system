# Copy to .env for local dev — these two vars are read at BUILD time by Vite
# (import.meta.env.VITE_*), so on Render they go in the static site's
# Environment > Environment Variables and trigger a rebuild when changed.

# Backend REST base URL (axios). No trailing slash.
VITE_BACKEND_BASE_URL=http://localhost:3500/api/v1

# Socket.IO base origin (no /api/v1 suffix). If omitted, the REST origin is used.
VITE_SOCKET_BASE_URL=http://localhost:3500