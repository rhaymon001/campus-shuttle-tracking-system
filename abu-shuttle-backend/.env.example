# Copy to .env and fill in real values. NEVER commit .env.
# Render web service: paste these into Environment > Environment Variables instead.

# MongoDB connection string (use an Atlas free cluster for Render)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/abu_shuttle

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-in-production

# Comma-separated browser origins allowed by CORS (Express + Socket.IO).
# In production this is the frontend's URL, e.g. https://abu-shuttle-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server port — Render injects PORT automatically; local default is 3500
PORT=3500

# Auto-turnaround tuning (optional, defaults shown)
TERMINUS_DWELL_METERS=60
TERMINUS_DWELL_FIXES=3
RETURN_DEPART_METERS=20